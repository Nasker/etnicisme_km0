{
  "$ref": "#/definitions/exhibits",
  "definitions": {
    "exhibits": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "person": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "slug": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "collection": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "collection"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "collection": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "slug",
                    "collection"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "name",
            "slug"
          ],
          "additionalProperties": false
        },
        "organisation": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "slug": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "slug"
          ],
          "additionalProperties": false
        },
        "room": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "collection": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "collection"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string"
                },
                "collection": {
                  "type": "string"
                }
              },
              "required": [
                "slug",
                "collection"
              ],
              "additionalProperties": false
            }
          ]
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "source": {
          "type": "object",
          "properties": {
            "platform": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "archive_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "platform",
            "url"
          ],
          "additionalProperties": false
        },
        "contextual_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "publication": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "publication",
              "title"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "media": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "alt"
          ],
          "additionalProperties": false
        },
        "quote": {
          "type": "string"
        },
        "verification": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "verified",
                "unverified",
                "placeholder"
              ]
            },
            "checked": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "integer",
                  "format": "unix-time"
                }
              ]
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "fictional": {
          "type": "boolean",
          "default": true
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "date",
        "person",
        "room",
        "source",
        "quote",
        "verification"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
---
import { url } from '../lib/url';

const path = Astro.url.pathname;
const homeHref = url('');
const links = [
  { href: url('museu'), label: 'El museu' },
  { href: url('sobre'), label: 'Sobre' },
  { href: url('correccions'), label: 'Correccions' },
];

const isActive = (href: string) =>
  href === homeHref ? (path === homeHref || path === import.meta.env.BASE_URL) : path.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={homeHref}>
      Etnicisme
      <strong>km 0</strong>
    </a>
    <nav class="site-nav" aria-label="Principal">
      {
        links.map((l) => (
          <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

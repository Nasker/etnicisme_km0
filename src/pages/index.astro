---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExhibitCard from '../components/ExhibitCard.astro';
import { getExhibitViews, getRoomsSorted, year } from '../lib/content';

const views = await getExhibitViews();
const rooms = await getRoomsSorted();
const featured = views.find((v) => v.entry.data.featured) ?? views[0];
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <h1 class="hero__title">
        Etnicisme<br />km 0
      </h1>
      <p class="hero__lede">
        Una exposició permanent sobre identitat, nació, immigració i exclusió.
      </p>
      <p class="hero__claim">
        Les peces són reals.<br />Les fonts també.
      </p>
      <a class="btn btn--accent" href="/museu">Entrar al museu →</a>
    </div>
  </section>

  <div class="container">
    <div class="stats">
      <div>
        <span class="stat__num">{views.length}</span>
        <span class="stat__label">Peces</span>
      </div>
      <div>
        <span class="stat__num">{rooms.length}</span>
        <span class="stat__label">Sales</span>
      </div>
      <div>
        <span class="stat__num">100%</span>
        <span class="stat__label">Font primària</span>
      </div>
    </div>

    {
      featured && (
        <section class="stack" style="margin-block:3rem">
          <div class="section-head">
            <h2>Peça destacada</h2>
            <span class="meta">{featured.entry.data.id}</span>
          </div>
          <div class="grid grid--cards">
            <ExhibitCard
              id={featured.entry.data.id}
              slug={featured.entry.id}
              quote={featured.entry.data.quote}
              person={featured.entry.data.person.name}
              personSlug={featured.personSlug}
              year={year(featured.entry.data.date)}
              room={featured.room.id}
              roomTitle={featured.room.data.title}
              topics={featured.entry.data.topics}
            />
          </div>
        </section>
      )
    }

    <hr class="rule rule--strong" />

    <section class="stack container--reading" style="margin-inline:0;margin-block:3rem 4rem">
      <div class="section-head">
        <h2>El museu</h2>
      </div>
      <p class="lede">
        Aquest projecte documenta i contextualitza discursos públics sobre
        identitat nacional, immigració, religió i pertinença.
      </p>
      <p class="lede">No et demanem que ens creguis. Mira les fonts.</p>
      <p><a class="btn" href="/sobre">Sobre el projecte</a></p>
    </section>
  </div>
</BaseLayout>

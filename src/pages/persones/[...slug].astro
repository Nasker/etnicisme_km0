---
import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExhibitCard from '../../components/ExhibitCard.astro';
import { getExhibitViews, year } from '../../lib/content';

export const getStaticPaths = (async () => {
  const views = await getExhibitViews();
  const bySlug = new Map<string, typeof views>();
  for (const v of views) {
    const list = bySlug.get(v.personSlug) ?? [];
    list.push(v);
    bySlug.set(v.personSlug, list);
  }

  const paths = [];
  for (const [slug, list] of bySlug) {
    if (list.length < 2) continue; // person pages only when 2+ exhibits
    const person = await getEntry('people', slug);
    paths.push({ params: { slug }, props: { person, list } });
  }
  return paths;
}) satisfies GetStaticPaths;

const { person, list } = Astro.props;
const name = person?.data.name ?? list[0].entry.data.person.name;
---

<BaseLayout title={name}>
  <div class="container container--reading" style="margin-inline:auto;padding-block:2.5rem 4rem">
    <p class="meta meta--accent">Persona</p>
    <h1 class="exhibit__title" style="margin-top:.5rem">{name}</h1>
    <p style="margin:0 0 .5rem"><span class="fiction-tag">Personatge fictici</span></p>
    {
      person?.data.role && (
        <p class="meta" style="text-transform:none;letter-spacing:.02em">
          {person.data.role}
          {person.data.organisation && <> · {person.data.organisation}</>}
        </p>
      )
    }
    {person?.data.note && <p class="prose" style="margin-top:1rem">{person.data.note}</p>}

    <hr class="rule rule--strong" />

    <div class="section-head">
      <h2>Peces documentades</h2>
      <span class="meta">{list.length}</span>
    </div>

    <div class="grid grid--cards">
      {
        list.map((v) => (
          <ExhibitCard
            id={v.entry.data.id}
            slug={v.entry.id}
            quote={v.entry.data.quote}
            person={v.entry.data.person.name}
            personSlug={v.personSlug}
            year={year(v.entry.data.date)}
            room={v.room.id}
            roomTitle={v.room.data.title}
            topics={v.entry.data.topics}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
